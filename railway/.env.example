# Copy to .env for local development. Never commit a populated .env.

# Supabase project URL (find in: Settings > API > Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — has write access; bypass RLS. Keep secret.
# Find in: Settings > API > service_role (secret) key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Shared secret the web frontend sends as X-Passcode on build/save calls.
# Required — server refuses to start without it (no insecure default).
# Pick anything, share with your teaching team, and set the same value as
# the frontend's localStorage passcode prompt.
REBUILD_PASSCODE=

# Railway sets PORT automatically. Override only for local dev.
PORT=8080
