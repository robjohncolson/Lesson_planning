{
  "name": "console-vendor",
  "private": true,
  "description": "Build step for CodeMirror 6 bundle shipped in console_static/vendor/codemirror.js",
  "type": "module",
  "scripts": {
    "build": "esbuild entry.mjs --bundle --format=esm --outfile=../console_static/vendor/codemirror.js --minify --legal-comments=none"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.34.1",
    "codemirror": "^6.0.1",
    "esbuild": "^0.24.0"
  }
}
